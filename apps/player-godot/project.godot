; CineWeave Godot Player
; Edit through the Godot editor where practical so resource formats stay canonical.

config_version=5

[application]

config/name="CineWeave"
config/description="A cinematic interactive story player."
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0196, 0.0275, 0.0509, 1)
